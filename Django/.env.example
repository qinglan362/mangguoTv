# ============================================================
# 本地开发配置模板：复制本文件为 .env 后填写真实值
# 注意：本模板会被 git 跟踪，请勿把真实 Cookie 填在这里！
# 修改后需重启 Django 服务（runserver / runscheduler）才会生效
# ============================================================

# ===== DeepSeek LLM（全站统一，所有 LLM 场景共用同一个 Key）=====
# 正负面/相关性/观点实体分析、报告摘要等全部走这里；
# 获取方式：https://platform.deepseek.com → API Keys → 创建后粘贴到等号后面。
# 未配置时系统自动降级为规则层/模板摘要（功能可用，但无 LLM 增强）。
DEEPSEEK_API_KEY=

# 可选：模型名（默认 deepseek-v4-pro；如平台提示模型不存在，可改为 deepseek-chat 等）
# LLM_MODEL=deepseek-v4-pro

# 可选：API 地址（默认 https://api.deepseek.com，一般无需修改）
# LLM_BASE_URL=https://api.deepseek.com

# ===== 小红书采集器（plugins/xiaohongshu.py 读取）=====
# 获取方式：浏览器登录 https://www.xiaohongshu.com ，F12 → Network →
# 点任意请求 → 请求头里复制完整 Cookie（需包含 a1 / webId / gid / web_session 等）
XHS_COOKIE=

# 可选：x-s 签名。留空则用插件内置的 Playwright + stealth.min.js 自动签名；
# 也可填独立签名服务地址（官方 Flask/Docker 方案，POST {地址}/sign）
XHS_SIGN_SERVER=

# 可选：登录浏览器的 User-Agent，风控严（频繁 461/验证码）时填写
XHS_USER_AGENT=

# 可选：每次采集对互动量最高的前 N 条帖子抓评论（默认 5，置 0 关闭）
XHS_COMMENT_TOP_N=5

# ===== 微博采集器（plugins/weibo.py 读取）=====
# 获取方式：浏览器登录 https://m.weibo.cn ，F12 → Network →
# 点任意 api 请求 → 请求头里复制完整 Cookie（SUB=...; SUBP=...; _T_WM=...）
WEIBO_COOKIE=

# 可选：每次采集对互动量最高的前 N 条帖子抓热评（默认 5，置 0 关闭）
WEIBO_COMMENT_TOP_N=5

# ===== 预警邮件通知（预警中心「邮件」渠道）=====
# 填好以下三项并去掉注释即开启；未开启时邮件渠道自动回退站内通知。
# QQ 邮箱授权码获取：网页版 QQ 邮箱 → 设置 → 账号与安全 → 安全设置 →
# 开启「SMTP/IMAP/POP3 服务」→ 生成授权码（不是 QQ 登录密码！）
# DJANGO_EMAIL_ENABLED=1
# DJANGO_EMAIL_USER=yourmail@qq.com
# DJANGO_EMAIL_PASSWORD=<SMTP 授权码>
# DJANGO_EMAIL_HOST=smtp.qq.com
# DJANGO_EMAIL_PORT=465
